# Puerto del servidor API
PORT=3000

# Cadena de conexión a PostgreSQL (Neon). Ejemplo, sin valores reales:
# postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require
DATABASE_URL=

# Secreto para firmar los tokens JWT
JWT_SECRET=

# Orígenes permitidos por CORS, separados por comas (varios dominios).
# En producción agrega el dominio de Vercel, p. ej.:
# CORS_ORIGIN=https://tu-app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Correo de invitaciones (Brevo) ---

# Clave de API de Brevo (la autenticación de la API SMTP va en el encabezado
# "api-key"). Solo fuera de producción, mientras esté vacía, los correos se
# SIMULAN: quedan en memoria (visibles en GET
# /api/admin/usuarios/invitaciones-simuladas) sin enviarse ni imprimirse.
# En producción (NODE_ENV=production) NO hay simulación: si falta esta clave
# o CORREO_REMITENTE, el envío se marca como fallido
# (invitacion_enviada = FALSE) y el administrador debe reenviar la invitación.
BREVO_API_KEY=

# Remitente del correo. Debe ser una dirección o un dominio VERIFICADO en tu
# cuenta de Brevo; si no lo está, la API rechaza el envío. El valor de abajo
# es solo un marcador: reemplázalo por tu remitente verificado.
CORREO_REMITENTE=tu-remitente-verificado@ejemplo.com
CORREO_REMITENTE_NOMBRE=La Mansión Store

# Enlace profundo al login de la app (solo ?vista=login). La pantalla de
# cambio de contraseña NO se enlaza: aparece después de iniciar sesión con
# la contraseña temporal. En producción, cámbialo por la URL de tu app.
APP_LOGIN_URL=http://localhost:5173/?vista=login

# Vencimiento de la contraseña temporal de invitación, en horas.
CONTRASENA_TEMPORAL_HORAS=48

# Límite de frecuencia del botón "Reenviar invitación": segundos mínimos entre
# dos reenvíos para el mismo usuario (por defecto 60).
REENVIO_INVITACION_SEGUNDOS=60

# --- Recuperación de contraseña (código por correo) ---

# Secreto del servidor para firmar los códigos de recuperación con
# HMAC-SHA256. OBLIGATORIO: sin él, los endpoints de recuperación fallan
# de forma controlada. Genéralo uno largo y aleatorio, p. ej.:
#   openssl rand -hex 32
RECUPERACION_HMAC_SECRETO=

# Vigencia del código de recuperación, en minutos (por defecto 15).
RECUPERACION_CODIGO_MINUTOS=15

# Intentos fallidos permitidos antes de invalidar el código (por defecto 5).
RECUPERACION_INTENTOS_MAX=5

# Segundos mínimos entre solicitudes para el mismo correo (por defecto 60).
RECUPERACION_REENVIO_SEGUNDOS=60

# Máximo de solicitudes de recuperación por IP dentro de la ventana
# (por defecto 5).
RECUPERACION_MAX_POR_IP=5

# Ventana del límite por IP, en minutos (por defecto 15).
RECUPERACION_VENTANA_IP_MINUTOS=15


# --- Limites de tasa por IP (Fase A) ---

# Inicios de sesion por IP: maximo y ventana en minutos (por defecto 10/15).
LOGIN_MAX_POR_IP=10
LOGIN_VENTANA_MIN=15

# Registros publicos por IP: maximo y ventana en minutos (por defecto 5/60).
REGISTRO_MAX_POR_IP=5
REGISTRO_VENTANA_MIN=60

# Intentos de verificacion/cambio del codigo de recuperacion por IP
# (por defecto 20 cada 15 min).
RECUPERACION_CODIGOS_MAX_POR_IP=20
RECUPERACION_CODIGOS_VENTANA_MIN=15

# Limite general de peticiones por IP (Fase B): maximo y ventana en minutos
# (por defecto 300 cada 15 min). Se monta DESPUES de /api/health, asi la
# sonda de Render nunca puede quedar bloqueada por una rafaga.
GENERAL_MAX_POR_IP=300
GENERAL_VENTANA_MIN=15


# Minimo entre la apertura del formulario de registro y su envio, en
# milisegundos (por defecto 3000), y tolerancia maxima al reloj del navegador
# (por defecto 120000).
REGISTRO_TIEMPO_MINIMO_MS=3000
REGISTRO_DESVIO_MAX_MS=120000

# SOLO PARA TESTS: 1 desactiva todos los limites de tasa. Nunca lo definas
# en produccion.
# RATE_LIMIT_OFF=1
