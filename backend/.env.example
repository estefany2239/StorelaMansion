# Puerto del servidor API
PORT=3000

# Cadena de conexión a PostgreSQL (Neon). Ejemplo, sin valores reales:
# postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require
DATABASE_URL=

# Secreto para firmar los tokens JWT
JWT_SECRET=

# Orígenes permitidos por CORS, separados por comas (varios dominios).
# En producción agrega el dominio de Vercel, p. ej.:
# CORS_ORIGIN=https://tu-app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Correo de invitaciones (Brevo) ---

# Clave de API de Brevo (la autenticación de la API SMTP va en el encabezado
# "api-key"). Solo fuera de producción, mientras esté vacía, los correos se
# SIMULAN: quedan en memoria (visibles en GET
# /api/admin/usuarios/invitaciones-simuladas) sin enviarse ni imprimirse.
# En producción (NODE_ENV=production) NO hay simulación: si falta esta clave
# o CORREO_REMITENTE, el envío se marca como fallido
# (invitacion_enviada = FALSE) y el administrador debe reenviar la invitación.
BREVO_API_KEY=

# Remitente del correo. Debe ser una dirección o un dominio VERIFICADO en tu
# cuenta de Brevo; si no lo está, la API rechaza el envío. El valor de abajo
# es solo un marcador: reemplázalo por tu remitente verificado.
CORREO_REMITENTE=tu-remitente-verificado@ejemplo.com
CORREO_REMITENTE_NOMBRE=La Mansión Store

# Enlace profundo al login de la app (solo ?vista=login). La pantalla de
# cambio de contraseña NO se enlaza: aparece después de iniciar sesión con
# la contraseña temporal. En producción, cámbialo por la URL de tu app.
APP_LOGIN_URL=http://localhost:5173/?vista=login

# Vencimiento de la contraseña temporal de invitación, en horas.
CONTRASENA_TEMPORAL_HORAS=48

# Límite de frecuencia del botón "Reenviar invitación": segundos mínimos entre
# dos reenvíos para el mismo usuario (por defecto 60).
REENVIO_INVITACION_SEGUNDOS=60
